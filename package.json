{
  "name": "forgeos-lite-trueforge",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "A controlled local project harness built around TrueForge for the Agent Harness Hackathon.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format:check": "node scripts/check-format.mjs",
    "control": "node --env-file-if-exists=.env.local packages/control/src/index.js",
    "forgeos": "node --env-file-if-exists=.env.local packages/cli/src/index.js",
    "demo": "npm run forgeos -- demo",
    "demo:real": "npm run forgeos -- real",
    "demo:check": "npm run forgeos -- check",
    "demo:deny": "npm run forgeos -- demo --deny",
    "secret:check": "node scripts/check-secrets.mjs",
    "test:integration:approval": "node scripts/run-phase3-live-proof.mjs",
    "test:integration:mission": "node scripts/run-phase4-live-proof.mjs",
    "test:integration:trueforge": "node scripts/run-trueforge-live-proof.mjs",
    "test:unit": "node --test",
    "test:language": "node scripts/check-language.mjs",
    "test": "npm run format:check && npm run test:unit && npm run test:language && npm run secret:check",
    "verify": "npm test && npm audit --audit-level=low"
  },
  "devDependencies": {
    "@truefoundry/trueforge": "0.1.4"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
